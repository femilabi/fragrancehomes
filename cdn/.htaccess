<FilesMatch "\.(txt|xml|js|css)$">
	#Header set Cache-Control "proxy-revalidate, max-age=604800"
</FilesMatch>
<FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2)$">
	#Header set Cache-Control "proxy-revalidate, max-age=604800"
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
    </IfModule>
</FilesMatch>